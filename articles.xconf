<?xml version="1.0" encoding="UTF-8"?>
<collection xmlns="http://exist-db.org/collection-config/1.0">
    <index xmlns:tei="http://www.tei-c.org/ns/1.0">
        <!-- Disable the legacy full text index -->
        <fulltext default="none" attributes="false"/>
        <!-- Lucene index configuration -->
        <lucene vector-store="db">
            <analyzer class="org.apache.lucene.analysis.standard.StandardAnalyzer"/>
            <!-- English stemming (possessives, then Porter), no stopwords, for
                 hsg-jinks's optional "match word forms" search. -->
            <analyzer id="stemmed" class="org.apache.lucene.analysis.en.EnglishAnalyzer">
                <param name="stopwords" type="org.apache.lucene.analysis.util.CharArraySet"/>
            </analyzer>
            <text qname="tei:div"/>
            <text qname="tei:body">
                <!-- start required facets and fields -->
                <facet dimension="hsg-category" expression="'countries'"/>
                <facet dimension="hsg-publication" expression="'countries-articles'"/>
                <field name="hsg-fulltext"/>
                <field analyzer="stemmed" name="hsg-fulltext-stemmed"/>
                <vector-field name="hsg-embedding"
                    dimension="384" similarity="cosine"
                    embedding="local" model="all-MiniLM-L6-v2"/>
                <field name="hsg-url" expression="'/countries/' || util:document-name(.) =&gt; substring-before('.xml')"/>
                <!-- end required facets and fields -->
            </text>
        </lucene>
    </index>
</collection>
